# MongoDB server connection string; the application always uses the marketplace database
MONGODB_URI=your_mongodb_connection_string
# Firebase Web API Key (Firebase Console > Project Settings > General > Web API Key)
FIREBASE_API_KEY=your_firebase_api_key
# Cloudinary signed-upload credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini API configuration for the marketplace assistant
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
